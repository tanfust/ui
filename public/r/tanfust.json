    "@import \"tw-animate-css\"": {},
    "@layer base": {
      "*": {
        "@apply border-border outline-ring": {}
      },
      "body": {
        "@apply bg-background text-foreground": {}
      }
    }
  },
  "meta": {
    "tier": "free",
    "version": "2.0.0"
  },
  "docs": "Tanfust base installed: an ink-on-paper palette and square corners. Body text is Geist Sans; labels and headings are Geist Mono — use `font-mono` with `text-2xs uppercase tracking-wider` for the stamp voice. BREAKING since 1.x: this item no longer declares `font-heading` (use `font-mono`), the palette is warm neutral rather than zinc, and `--radius` is 0. Browse items with `npx shadcn@latest list @tanfust`.",
  "categories": [
    "foundations"
  ],
  "type": "registry:base",
  "config": {
    "tailwind": {
      "baseColor": "stone"
    },
    "iconLibrary": "lucide",
    "menuColor": "inverted",
    "menuAccent": "bold",
    "registries": {
      "@tanfust": "https://ui.tanfust.com/r/{name}.json"
    }
  }
