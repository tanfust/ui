{
  "name": "@tanfust/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Essential components, hooks and flows for everyday sites and apps — a shadcn-compatible registry (@tanfust).",
  "homepage": "https://ui.tanfust.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tanfust/ui.git"
  },
  "bugs": {
    "url": "https://github.com/tanfust/ui/issues"
  },
  "license": "MIT",
  "author": "Tanfust <https://tanfust.com>",
  "keywords": [
    "shadcn",
    "shadcn-registry",
    "react",
    "tailwindcss",
    "tanstack-start",
    "design-system",
    "hooks",
    "components"
  ],
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm registry:build && vite dev --port 3000",
    "build": "pnpm registry:build && vite build",
    "preview": "vite preview --port 3000",
    "start": "node .output/server/index.mjs",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs}\"",
    "check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs}\"",
    "typecheck": "tsc --noEmit",
    "registry:validate": "shadcn registry validate",
    "registry:build": "node scripts/build-registry.mjs",
    "registry:check": "pnpm registry:build && git diff --exit-code -- public/r",
    "smoke": "bash scripts/smoke-install.sh"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-devtools": "^0.10.12",
    "@tanstack/react-router": "^1.170.35",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/react-router-ssr-query": "^1.167.2",
    "@tanstack/react-start": "^1.168.52",
    "@tanstack/router-plugin": "^1.168.37",
    "cn": "^0.3.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.1.14",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/eslint-config": "^0.4.0",
    "@types/node": "^22.20.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.0",
    "nitro": "3.0.260903-beta",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.0",
    "vite": "^8.3.0"
  }
}
